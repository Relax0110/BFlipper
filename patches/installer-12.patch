+static bool isFlipperAdvertisement(const QBluetoothDeviceInfo &info)
+{
+    if(info.name().contains(QStringLiteral("flipper"), Qt::CaseInsensitive)) {
+        return true;
+    }
+
+    for(const QBluetoothUuid &uuid : info.serviceUuids()) {
+        bool ok = false;
+        const quint16 shortUuid = uuid.toUInt16(&ok);
+        if(ok && shortUuid >= 0x3080 && shortUuid <= 0x3083) {
+            return true;
+        }
+    }
+    return false;
+}
