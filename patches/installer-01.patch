diff --git a/application/application.pro b/application/application.pro
index c8b2433..5e667e5 100644
--- a/application/application.pro
+++ b/application/application.pro
@@ -1,5 +1,16 @@
 QT += quick serialport widgets quickcontrols2 svg
 
+# qFlipper's RPC protocol also runs over the Flipper Serial BLE GATT service.
+# Qt Bluetooth uses CoreBluetooth on macOS, BlueZ on Linux and WinRT on Windows.
+win32|linux|macx {
+    QT += bluetooth
+    DEFINES += QFLIPPER_BLE
+    SOURCES += blespike.cpp bletransport.cpp
+    HEADERS += blespike.h bletransport.h
+}
+
+macx: QMAKE_INFO_PLIST = $$PWD/Info.plist.app
+
 include(../qflipper_common.pri)
 
 TARGET = $$NAME
