#!/bin/sh
# Apply a low-latency interval to connected Flipper Serial BLE services.
last_handles=""

while :; do
    current_handles=""
    bluetoothctl devices Connected 2>/dev/null | while read -r _ address _; do
        [ -n "$address" ] || continue
        if bluetoothctl info "$address" 2>/dev/null \
            | grep -qi '8fe5b3d5-2e7f-4a98-2a48-7acc60fe0000'; then
            hcitool con 2>/dev/null \
                | awk -v target="$(printf '%s' "$address" | tr '[:upper:]' '[:lower:]')" \
                    'tolower($0) ~ target { for (i = 1; i < NF; ++i) if ($i == "handle") { print $(i + 1); exit } }'
        fi
    done > /run/bflipper-ble-handles
    current_handles=$(cat /run/bflipper-ble-handles 2>/dev/null)

    for handle in $current_handles; do
        case " $last_handles " in
            *" $handle "*) ;;
            *)
                if hcitool lecup "$handle" 6 12 0 200; then
                    logger -t bflipper-ble "Requested 7.5 ms interval for Flipper handle $handle"
                fi
                ;;
        esac
    done
    last_handles="$current_handles"
    sleep 1
done
